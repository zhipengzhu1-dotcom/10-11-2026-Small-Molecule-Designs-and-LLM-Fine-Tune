{
  "name": "s1-factory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"factory/**/*.test.mjs\"",
    "ci": "node scripts/ci.mjs",
    "fetch-page": "node factory/fetch-page.mjs",
    "fetch:s1": "node scripts/fetch-s1.mjs",
    "check:tables": "node factory/checks/tables.mjs --tex research/s1/raw/arxiv/latex/main.tex --notes research/s1/tables --notes research/s1/figures",
    "hooks:install": "git config core.hooksPath .githooks"
  }
}
